<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to resolve the first YouTube search result before opening it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- "Rehan ko whatsapp pe message bhejo" -> naam se number dhoondne ke liye. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- SMS aur call. Ye dono runtime pe bhi maange jate hain. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Hands-free: "Hey E.V" sunne ke liye. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        "Photo lo" / "video banao".
        Android 9 aur usse purane phones me gallery me save karne ke liye storage
        permission chahiye; Android 10+ me MediaStore khud sambhal leta hai.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Device controls -->
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- "5 minute ka timer lagao" -> phone ki Clock app me set hota hai. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!--
        Reminders. SCHEDULE_EXACT_ALARM Android 12+ pe user se maanga jata hai;
        na mile to E.V inexact alarm pe fallback kar leta hai.
        RECEIVE_BOOT_COMPLETED isliye ki reboot ke baad pending reminders
        dobara set ho jayein — Android reboot pe saare alarms bhool jata hai.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!--
        Android 11+ package visibility.
        The MAIN/LAUNCHER <intent> block is what lets E.V see and list EVERY
        launchable app installed on the phone, without needing the
        QUERY_ALL_PACKAGES permission (which Play Store restricts).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CALL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEARCH" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>

        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.youtube.music" />
        <package android:name="com.spotify.music" />
        <package android:name="com.gaana" />
        <package android:name="com.jio.media.jiobeats" />
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.instagram.android" />
        <package android:name="com.google.android.googlequicksearchbox" />
        <package android:name="com.shazam.android" />
        <package android:name="com.google.android.deskclock" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EV">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.EV">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Photo/video lene wali patli activity. Recents me nahi dikhti aur
            kaam khatam hote hi khud band ho jati hai.
        -->
        <activity
            android:name=".feature.camera.CameraCaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.EV"
            tools:ignore="LockedOrientationActivity" />

        <service
            android:name=".feature.voice.EvListeningService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".feature.accessibility.EvAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Reminder bajne par, aur reboot ke baad reschedule karne ke liye. -->
        <receiver
            android:name=".feature.reminders.ReminderReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
